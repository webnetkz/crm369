<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds may connect to development portals over plain HTTP (for example a Laravel
    server on the local network). Release builds use the strict HTTPS-only configuration.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
