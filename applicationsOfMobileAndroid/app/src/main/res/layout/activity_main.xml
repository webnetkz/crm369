<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/portal_screen_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/mainToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/portal_surface"
        app:title="@string/app_name" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/greetingText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_greeting"
                android:textColor="@color/portal_text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/profileText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/portal_text_secondary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/pushStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/portal_primary_soft"
                android:padding="12dp"
                android:textColor="@color/portal_text_primary"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/notificationsButton"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/module_notifications"
                    android:textAllCaps="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chatsButton"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/module_chats"
                    android:textAllCaps="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/projectsButton"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/module_projects"
                    android:textAllCaps="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/contactsButton"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/module_contacts"
                    android:textAllCaps="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/calendarButton"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/module_calendar"
                    android:textAllCaps="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/knowledgeButton"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/module_knowledge"
                    android:textAllCaps="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/companyButton"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/module_company"
                    android:textAllCaps="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/warehousesButton"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/module_warehouses"
                    android:textAllCaps="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/equipmentButton"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/module_equipment"
                    android:textAllCaps="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/scannerButton"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:icon="@drawable/ic_qr_scan"
                    android:text="@string/module_scanner"
                    android:textAllCaps="false" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logoutButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/action_logout"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/changeDomainButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_change_domain"
                android:textAllCaps="false" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
